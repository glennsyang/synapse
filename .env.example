# App runtime vars (validated in src/env.ts — see docs/ENVIRONMENT.md for details)
NODE_ENV=development
DATABASE_URL=data/sample.db
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_BASE_URL=http://localhost
AUTH_ALERTS_URL=https://ntfy.sh/your-auth-alerts-topic
REMINDER_ALERTS_URL=https://ntfy.sh/your-reminder-alerts-topic
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_ADDRESS=noreply@example.com
BREVO_NEW_USER_ADDRESS=admin@example.com
CRON_SECRET=your-cron-secret-key-here
# Not secret (already public in the client SDK bundle) — safe to leave as-is locally.
SENTRY_DSN=https://0941b6e2d9801402928ec265ba858ff9@o4510809399492608.ingest.us.sentry.io/4511970268020736
# Optional; defaults to debug in dev, info in prod. One of debug/info/warn/error.
# LOG_LEVEL=debug

# CI / infra only — not read by the app at runtime; set as GitHub Actions repo secrets.
APP_URL=http://localhost
FLY_API_TOKEN=your_fly_api_token_here
# Used by .github/workflows/backup-database.yml to encrypt database dumps.
BACKUP_ENCRYPTION_PASSPHRASE=your_backup_encryption_passphrase_here
# Used by .github/workflows/fly-deploy.yml to upload source maps to Sentry during the
# Docker build (see Dockerfile's SENTRY_AUTH_TOKEN build secret). Optional — the build
# succeeds without it, just skipping source-map upload.
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
