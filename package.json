{
	"name": "synapse",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "biome format --write .",
		"lint": "biome ci . && npm run lint:static",
		"lint:fix": "biome check --write .",
		"lint:static": "npm run check:redirect-throws && npm run check:dead-exports && npm run check:no-explicit-any-reviewed-scope",
		"check:redirect-throws": "node scripts/check-redirect-throws.mjs",
		"check:dead-exports": "node scripts/check-dead-exports.mjs",
		"check:no-explicit-any-reviewed-scope": "node scripts/check-no-explicit-any-reviewed-scope.mjs",
		"check:all": "npm run format && npm run lint && npm run test",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"test": "npm run test:unit -- --run",
		"update-deps": "npm outdated || npm update",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"lint-staged": {
		"*.{js,ts,svelte,json,css,md}": [
			"biome check --write ."
		],
		"*.svelte": [
			"svelte-check --tsconfig ./tsconfig.json --threshold error"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@flydotio/dockerfile": "^0.7.10",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.7.0",
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-cloudflare": "^7.2.4",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.49.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/table-core": "^8.21.3",
		"@types/better-sqlite3": "^7.6.12",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.7",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^25.0.2",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"embla-carousel-svelte": "^8.6.0",
		"knip": "^5.85.0",
		"layerchart": "^2.0.0-next.43",
		"lefthook": "^2.0.16",
		"lint-staged": "^16.2.7",
		"svelte": "^5.55.1",
		"svelte-check": "^4.3.4",
		"svelte-dnd-action": "^0.9.69",
		"svelte-sonner": "^1.1.0",
		"sveltekit-superforms": "^2.29.1",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^7.2.7",
		"vitest": "^4.0.15",
		"zod": "^4.3.5"
	},
	"dependencies": {
		"better-auth": "^1.5.4",
		"better-sqlite3": "^12.6.2",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"dotenv": "^17.3.1",
		"dotenv-expand": "^12.0.3",
		"drizzle-kit": "^0.31.9",
		"drizzle-orm": "^0.45.1",
		"markdown-it": "^14.1.1",
		"marked": "^17.0.5",
		"mode-watcher": "^1.1.0",
		"resend": "^6.9.3"
	},
	"overrides": {
		"hono": "4.12.5",
		"@hono/node-server": "1.19.11"
	}
}
