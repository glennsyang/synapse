{
	"name": "synapse",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint && npm run check:dead-code",
		"lint:fix": "oxlint --fix",
		"lint:github": "oxlint --format=github",
		"check:redirect-throws": "node scripts/check-redirect-throws.mjs",
		"check:dead-code": "fallow dead-code --format human",
		"check:all": "npm run fmt && npm run lint && npm run test",
		"test:e2e": "playwright test",
		"test": "npm run test:unit -- --run",
		"test:unit": "vitest",
		"test:ci": "npm run test:unit -- --run && npm run test:coverage",
		"test:coverage": "vitest run --coverage",
		"update-deps": "npm outdated || npm update",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"dependencies": {
		"@better-auth/api-key": "^1.7.4",
		"@getbrevo/brevo": "^6.0.3",
		"@sentry/sveltekit": "^10.74.0",
		"better-auth": "^1.7.4",
		"better-sqlite3": "^12.6.2",
		"canvas-confetti": "^1.9.4",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"drizzle-orm": "^0.45.1",
		"markdown-it": "^15.0.2",
		"mode-watcher": "^1.1.0",
		"sveltekit-rate-limiter": "^0.8.0"
	},
	"devDependencies": {
		"@flydotio/dockerfile": "^0.7.10",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.46.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.1",
		"@tanstack/svelte-table": "^9.2.4",
		"@tanstack/table-core": "^9.2.4",
		"@types/better-sqlite3": "^7.6.12",
		"@types/canvas-confetti": "^1.9.0",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.2.0",
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^26.5.1",
		"@vitest/coverage-v8": "^5.0.0",
		"bits-ui": "^2.19.2",
		"clsx": "^2.1.1",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"embla-carousel-svelte": "^8.6.0",
		"fallow": "^3.27.0",
		"layerchart": "^2.5.0",
		"lefthook": "^2.1.14",
		"lint-staged": "^17.5.1",
		"oxfmt": "^0.68.0",
		"oxlint": "^1.83.0",
		"oxlint-tsgolint": "^7.0.2001",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-dnd-action": "^0.9.79",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^8.3.0",
		"vitest": "^5.0.0",
		"zod": "^4.6.5"
	}
}
