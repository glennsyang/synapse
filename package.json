{
	"name": "synapse",
	"version": "0.0.4",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint && npm run lint:static",
		"lint:fix": "oxlint --fix",
		"lint:static": "npm run check:dead-exports && npm run check:redirect-throws && npm run check:no-explicit-any && npm run check:dead-code",
		"lint:github": "oxlint --format=github",
		"check:dead-exports": "node scripts/check-dead-exports.mjs",
		"check:redirect-throws": "node scripts/check-redirect-throws.mjs",
		"check:no-explicit-any": "node scripts/check-no-explicit-any.mjs",
		"check:dead-code": "fallow dead-code --format human",
		"check:all": "npm run fmt && npm run lint && npm run test",
		"test:e2e": "playwright test",
		"test": "npm run test:unit -- --run",
		"test:unit": "vitest",
		"test:ci": "npm run test:unit -- --run && npm run test:coverage",
		"test:coverage": "vitest run --coverage",
		"update-deps": "npm outdated || npm update",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"dependencies": {
		"better-auth": "^1.6.11",
		"better-sqlite3": "^12.6.2",
		"canvas-confetti": "^1.9.4",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.1",
		"markdown-it": "^14.1.1",
		"marked": "^18.0.3",
		"mode-watcher": "^1.1.0",
		"resend": "^6.10.0"
	},
	"devDependencies": {
		"@flydotio/dockerfile": "^0.7.10",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.21.0",
		"@playwright/test": "^1.61.0",
		"@sveltejs/adapter-cloudflare": "^7.2.4",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.66.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.1",
		"@tanstack/table-core": "^8.21.3",
		"@types/better-sqlite3": "^7.6.12",
		"@types/canvas-confetti": "^1.9.0",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.7",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^25.9.3",
		"@vitest/coverage-v8": "^4.1.9",
		"bits-ui": "^2.16.5",
		"clsx": "^2.1.1",
		"dotenv": "^17.4.2",
		"embla-carousel-svelte": "^8.6.0",
		"fallow": "^2.99.0",
		"knip": "^6.12.2",
		"layerchart": "^2.0.0-next.51",
		"lefthook": "^2.1.9",
		"lint-staged": "^17.0.7",
		"oxfmt": "^0.55.0",
		"oxlint": "^1.71.0",
		"oxlint-tsgolint": "^0.23.0",
		"svelte": "^5.55.1",
		"svelte-check": "^4.3.4",
		"svelte-dnd-action": "^0.9.69",
		"svelte-sonner": "^1.1.0",
		"sveltekit-superforms": "^2.29.1",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^8.0.12",
		"vitest": "^4.1.9",
		"zod": "^4.4.3"
	},
	"overrides": {
		"@hono/node-server": "1.19.11",
		"hono": "4.12.5"
	}
}
